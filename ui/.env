# Not needed for local dev - `vite.config.ts` proxies /api to the broker
# (localhost:8878 by default; override with BROKER_URL, unprefixed, when
# starting `npm run dev`) so the UI never has to know its address.
#
# Set VITE_BROKER_URL only to bypass the proxy and call a broker directly
# from the browser (e.g. a broker on another machine). That's a real
# cross-origin request, so the broker's BROKER_CORS_ORIGIN must list this
# UI's origin.
#VITE_BROKER_URL=http://localhost:8878
